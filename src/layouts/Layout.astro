---
import "../styles/global.css";
import Navbar from "../components/commons/navbar/navbar.astro";
import Footer from "../components/commons/footer/footer.astro";
import { ClientRouter } from "astro:transitions";
import { getAlternatePath, getLangFromPath, locales, translator } from "../i18n";
import langRedirect from "../i18n/lang-redirect.js?raw";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: unknown;
  // Una sola página para ambos idiomas (el 404): navbar y footer traen los dos
  // y el CSS muestra el de html[lang]
  bilingual?: boolean;
}

const lang = getLangFromPath(Astro.url.pathname);
const t = translator(lang);

const {
  title,
  description = t(
    "Portafolio de Mario de la Rosa, desarrollador fullstack en Ciudad de México: proyectos con React, Astro y Node.js, y experiencia en QA Automation.",
    "Portfolio of Mario de la Rosa, a fullstack developer in Mexico City: projects built with React, Astro, and Node.js, plus a background in QA Automation."
  ),
  noindex = false,
  jsonLd,
  bilingual = false,
} = Astro.props;

const siteName = "Mario de la Rosa";

// Sin título propio (la portada) se usa el título completo, no "Nombre | Nombre"
const pageTitle = title
  ? `${title} | ${siteName}`
  : t(
      "Mario de la Rosa — Desarrollador Fullstack | React, Astro, Node.js",
      "Mario de la Rosa — Fullstack Developer | React, Astro, Node.js"
    );

// Canónica con la misma forma que publica el sitemap (con barra final),
// para que las URLs de preview de Vercel no compitan con las buenas
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL(t("/og-image.png", "/og-image-en.png"), Astro.site).href;
const ogImageAlt = t(
  "Portafolio de Mario de la Rosa, desarrollador fullstack",
  "Portfolio of Mario de la Rosa, fullstack developer"
);

// Versión de esta página en cada idioma, para hreflang. El 404 no tiene.
const alternates = {
  es: getAlternatePath(Astro.url.pathname, "es"),
  en: getAlternatePath(Astro.url.pathname, "en"),
};
const hasAlternates = Boolean(alternates.es && alternates.en);

const identidad = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      url: new URL("/", Astro.site).href,
      name: siteName,
      inLanguage: [locales.es, locales.en],
      publisher: { "@id": new URL("/#person", Astro.site).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#person", Astro.site).href,
      name: "Mario de la Rosa",
      url: new URL("/", Astro.site).href,
      image: ogImage,
      jobTitle: t("Desarrollador Fullstack", "Fullstack Developer"),
      description: t(
        "Desarrollador fullstack con experiencia previa en QA Automation. Construye productos de principio a fin, de la base de datos a la interfaz.",
        "Fullstack developer with a background in QA Automation. Builds products end to end, from the database to the interface."
      ),
      address: {
        "@type": "PostalAddress",
        addressLocality: t("Ciudad de México", "Mexico City"),
        addressCountry: "MX",
      },
      alumniOf: { "@type": "CollegeOrUniversity", name: "UNIVDEP" },
      knowsAbout: [
        t("Desarrollo web fullstack", "Fullstack web development"),
        "React",
        "Astro",
        "Node.js",
        "TypeScript",
        "Tailwind CSS",
        "WordPress",
        "Back4App",
        "QA Automation",
        "Cypress",
      ],
      sameAs: [
        "https://www.linkedin.com/in/mdlr89/",
        "https://github.com/Umario-chan",
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {hasAlternates && (
      <>
        <link rel="alternate" hreflang={locales.es} href={new URL(alternates.es, Astro.site).href} />
        <link rel="alternate" hreflang={locales.en} href={new URL(alternates.en, Astro.site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site).href} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mario de la Rosa" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_MX"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "es_MX" : "en_US"} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(identidad)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <script is:inline set:html={langRedirect} />
    <ClientRouter />
  </head>
  <body class="bg-white text-gray-900">
    <Navbar bilingual={bilingual} />
    <slot />
    <Footer bilingual={bilingual} />
  </body>
</html>

<script>
  // Cada idioma tiene su propia URL (/ y /en/), pero el botón de idioma no
  // recarga: el ClientRouter trae la otra versión y la intercambia en sitio.
  // Aquí se guarda la preferencia y se conserva el scroll al cambiar.
  let langSwitch: { scrollY: number } | null = null;

  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-lang-switch]");
    if (!link) return;
    const next = link.dataset.langSwitch!;
    try {
      localStorage.setItem("lang", next);
    } catch {}
    langSwitch = { scrollY: window.scrollY };
  });

  document.addEventListener("astro:after-swap", () => {
    if (!langSwitch) return;
    // Es la misma página en otro idioma: se queda donde estaba y sin volver a
    // animar las secciones que ya se habían mostrado
    document.querySelectorAll(".reveal").forEach((el) => el.classList.add("reveal-visible"));
    window.scrollTo({ top: langSwitch.scrollY, behavior: "instant" });
    langSwitch = null;
  });

  function initReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("reveal-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".reveal:not(.reveal-visible)").forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initReveal);
</script>
