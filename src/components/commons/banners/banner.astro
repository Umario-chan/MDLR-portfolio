---
import { getLangFromPath, getPath, translator } from "../../../i18n";

const lang = getLangFromPath(Astro.url.pathname);
const t = translator(lang);
---

<section class="py-16 px-6">
  <div class="max-w-3xl mx-auto bg-[#1a6fec] rounded-3xl px-10 py-14 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-3">
      {t("¿Trabajamos juntos?", "Shall we work together?")}
    </h2>
    <p class="text-blue-100 text-base mb-8">
      {t("Estoy disponible para nuevas oportunidades. ¡Hablemos!", "I'm open to new opportunities. Let's talk!")}
    </p>
    <a
      href={getPath("contact", lang)}
      class="inline-block bg-white text-[#1a6fec] font-semibold px-8 py-3 rounded-full hover:bg-blue-50 transition-colors duration-200 text-sm shadow-md hover:shadow-lg"
    >
      {t("Contáctame", "Contact me")}
    </a>
  </div>
</section>
