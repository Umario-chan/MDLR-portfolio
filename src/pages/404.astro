---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" description="Página no encontrada" noindex={true} bilingual={true}>
  <!-- Vercel sirve este mismo 404 para cualquier ruta: bajo /en/ se muestra en inglés -->
  <script is:inline>
    if (location.pathname.startsWith("/en/")) document.documentElement.lang = "en";
  </script>
  <section class="min-h-screen flex flex-col items-center justify-center px-6 text-center bg-white dark:bg-gray-950">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#1a6fec] mb-4">Error</p>
    <h1 class="text-8xl md:text-9xl font-extrabold text-gray-900 dark:text-gray-100 mb-4">404</h1>
    <h2 class="text-xl md:text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-3">
      <span class="lang-es">Página no encontrada</span>
      <span class="lang-en">Page not found</span>
    </h2>
    <p class="text-gray-400 dark:text-gray-500 max-w-sm mx-auto mb-10 text-sm leading-relaxed">
      <span class="lang-es">El enlace al que intentaste acceder no existe o fue movido. Vuelve al inicio y sigue navegando.</span>
      <span class="lang-en">The link you tried to access doesn't exist or was moved. Head back home and keep browsing.</span>
    </p>
    <a href="/" class="lang-es inline-block bg-[#1a6fec] hover:bg-[#1255c4] text-white font-semibold px-8 py-3 rounded-full transition-colors duration-200 text-sm">Volver al inicio</a>
    <a href="/en/" class="lang-en inline-block bg-[#1a6fec] hover:bg-[#1255c4] text-white font-semibold px-8 py-3 rounded-full transition-colors duration-200 text-sm">Back to home</a>
  </section>
</Layout>
