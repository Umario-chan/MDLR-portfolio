---
import Layout from "../layouts/Layout.astro";
import MiFoto from "../assets/img/MiFoto.png";
import CopyMail from "../components/links/copyMail.jsx";
import { getLangFromPath, getPath, translator } from "../i18n";

const lang = getLangFromPath(Astro.url.pathname);
const t = translator(lang);

const links = [
  { href: "https://www.linkedin.com/in/mdlr89/", label: "LinkedIn" },
  { href: "https://github.com/Umario-chan", label: "GitHub" },
  { href: "https://wa.me/525529044570", label: "WhatsApp" },
  { href: "mailto:mario.delarosa@live.com.mx", label: "Email" },
];
---

<Layout
  title={t("Contacto", "Contact")}
  description={t(
    "Ponte en contacto con Mario de la Rosa, desarrollador fullstack en Ciudad de México. LinkedIn, GitHub, WhatsApp y correo.",
    "Get in touch with Mario de la Rosa, fullstack developer in Mexico City. LinkedIn, GitHub, WhatsApp, and email."
  )}
>
  <section class="min-h-screen flex flex-col items-center justify-center px-6 bg-white pt-24 pb-16">
    <div class="mb-8">
      <div class="relative flex items-center justify-center">
        <img
          src={MiFoto.src}
          alt={t("Foto de Mario", "Photo of Mario")}
          class="h-28 w-28 rounded-full border-2 border-gray-200 shadow-sm object-cover"
        />
        <svg viewBox="0 0 200 200" class="animate-spin-slow absolute h-44 w-44">
          <path
            id="circlePathText"
            d="M100,100 m-77,0 a77,77 0 1,1 154,0 a77,77 0 1,1 -154,0"
            fill="none"
          ></path>
          <text fill="#1a6fec" font-size="16" font-weight="600" letter-spacing="2">
            <textPath href="#circlePathText" startOffset="0%">
              {t("✦ Hola ! ✦ Estoy disponible para nuevas oportunidades!", "✦ Hi ! ✦ I'm open to new opportunities!")}
            </textPath>
          </text>
        </svg>
      </div>
    </div>

    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#1a6fec] mb-2">
      {t("Contacto", "Contact")}
    </p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">
      {t("Hablemos", "Let's talk")}
    </h1>
    <p class="text-gray-400 text-sm mb-8">
      {t("Elige cómo quieres conectar conmigo", "Choose how you'd like to connect")}
    </p>

    <CopyMail lang={lang} client:visible />

    <div class="w-full max-w-sm space-y-3 mt-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-full rounded-xl border border-gray-200 bg-white hover:border-[#1a6fec]/40 hover:bg-gray-50 px-6 py-3 text-sm font-semibold text-gray-700 transition-all duration-200"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href={getPath("cv", lang)}
      target="_blank"
      class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gray-400 hover:text-[#1a6fec] transition-colors duration-200"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      {t("Descargar CV", "Download CV")}
    </a>
  </section>
</Layout>

<style>
  .animate-spin-slow {
    animation: spin 25s linear infinite;
  }
  @keyframes spin {
    100% { transform: rotate(360deg); }
  }
</style>
